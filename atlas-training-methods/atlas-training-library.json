  "global_rules": {
    "exercise_selection": [
      "فقط exercise_id موجود در کتابخانه حرکات و سازگار با تجهیزات و محدودیت کاربر",
      "حرکات اصلی پیش از کمکی‌ها؛ حرکات اصلی بین هفته‌ها ثابت بمانند",
      "گرم‌کردن در شمار ست کاری محاسبه نشود"
    ],
    "effort": {
      "default_rir": [
        2,
        3
      ],
      "meaning_fa": "تعداد تکرار باقیمانده با فرم صحیح؛ برآورد است، نه اندازه‌گیری قطعی",
      "no_mandatory_failure": true
    },
    "progression": {
      "type": "double_progression",
      "rule_fa": "وقتی تمام ست‌ها در دو نوبت متوالی به سقف دامنه تکرار با RIR هدف و فرم صحیح رسیدند، کوچک‌ترین افزایش عملی بار اعمال شود؛ حدود ۲ تا ۵ درصد انتخاب پیش‌فرض Atlas است، نه قانون همه متدها.",
      "plateau_fa": "با افت عملکرد یا ریکاوری، ابتدا بار/ست را کم کن؛ افزایش هفتگی اجباری ممنوع.",
      "deload_fa": "در خستگی پایدار یا افت چندجلسه‌ای، ۵ تا ۷ روز حجم حدود ۳۰ تا ۵۰ درصد کمتر؛ سیاست Atlas، نه نسخه رسمی همه منابع."
    },
    "constraints": [
      "زمان واقعی ست‌ها، استراحت و گرم‌کردن باید در زمان جلسه جا شود",
      "درد با حرکت، محدودیت پزشکی و تجهیزات بر وفاداری به متد اولویت دارند",
      "تعداد ایستگاه یا سوپرست اجباری نباید حجم یا شدت متد را مخدوش کند",
      "هیچ درصد چربی یا تشخیص پزشکی از عکس تولید نشود"
    ],
    "claim_policy": "برتری قطعی، نتیجه تضمینی یا تأیید رسمی نویسنده برای Atlas ادعا نشود"
